{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/build-release-debs.sh ${nextRelease.version} && bash scripts/build-release-rpm.sh ${nextRelease.version}",
        "publishCmd": "echo ${nextRelease.version} > release-debs/.released-version"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"]
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release-debs/*+jammy*.deb",
            "label": "Debian/Ubuntu amd64 (.deb) - Ubuntu 22.04 jammy"
          },
          {
            "path": "release-debs/*+noble*.deb",
            "label": "Debian/Ubuntu amd64 (.deb) - Ubuntu 24.04 noble"
          },
          {
            "path": "release-debs/*+resolute*.deb",
            "label": "Debian/Ubuntu amd64 (.deb) - Ubuntu 26.04 resolute"
          },
          {
            "path": "release-rpms/*.rpm",
            "label": "RPM x86_64 (.rpm) - Fedora"
          }
        ]
      }
    ]
  ]
}
